# Public introduction runs without service configuration. Account routes fail
# closed until all four integration values are configured and verified.
# Optional server-only origin for metadata; HTTP is accepted for localhost only.
APP_URL=http://localhost:3000
# Development configuration supplied by the owner in ignored .env.local only.
# Keep these blank in the tracked example. Never put secrets in conversation,
# screenshots, logs, Git, NEXT_PUBLIC_ secrets, or command-line arguments.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The Clerk instance must enable native Supabase integration, and the same
# issuer must be configured as third-party auth in the selected Supabase dev project.
# Ordinary requests do not use a Supabase service-role/secret key.
# Attachments only: server-only, separately revocable worker secret. Never use
# this key in a browser or ordinary membership/marketplace requests.
SUPABASE_ATTACHMENT_WORKER_KEY=
# Private ClamAV daemon, with UTC timestamps, current signatures, encrypted/
# scan-limit alerts enabled. Empty host disables uploads; links still work.
CLAMAV_HOST=
CLAMAV_PORT=3310
